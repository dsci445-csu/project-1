# --- Define Helper Function to Calculate Error Rate (1 - Accuracy) ---
calculate_error <- function(model_fit, data_set) {
  predictions <- predict(model_fit, new_data = data_set, type = "class")
  results <- data_set |> 
    select(Purchase) |> 
