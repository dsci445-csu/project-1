  # Update beta1_hat (Holding new beta2_hat_new Fixed) ---
  Y_adj_for_beta1 <- df_backfit$Y - (beta2_hat_new * df_backfit$X2)
  fit_beta1 <- lm(Y_adj_for_beta1 ~ df_backfit$X1)
  beta0_hat_new <- coef(fit_beta1)[1] 
  beta1_hat_new <- coef(fit_beta1)[2] 
  
  
  #HISTORY
  coef_history_new[k, ] <- c(k, beta0_hat_new, beta1_hat_new, beta2_hat_new)
}

#Convert History to Long Format for Plotting
df_history_new <- as.data.frame(coef_history_new)
df_long_new <- df_history_new |>
  pivot_longer(
    cols = starts_with("Beta"),
    names_to = "Coefficient",
    values_to = "Estimate_Value"
  )

df_long_original <- df_long |> mutate(Start_Value = "Initial (Beta1 = 10)")
df_long_new_start <- df_long_new |> mutate(Start_Value = "New Start (Beta1 = 0)")

# Combine into one data frame
df_comparison <- bind_rows(df_long_original, df_long_new_start)

# --- 2. Overlay Comparison Plot ---

# Define True Coefficients (Assumed from previous steps)
true_beta0 <- 1
true_beta1 <- 3
true_beta2 <- -4

ggplot(df_comparison, aes(x = Iteration, y = Estimate_Value, 
                          group = interaction(Coefficient, Start_Value), 
                          color = Coefficient, linetype = Start_Value)) +
  geom_line(linewidth = 1) +
  
  # Overlay the horizontal lines for the true coefficients
  geom_hline(yintercept = true_beta1, linetype = "dotted", color = "red", alpha = 0.7) +
  geom_hline(yintercept = true_beta2, linetype = "dotted", color = "blue", alpha = 0.7) +
  
  labs(
    title = "Backfitting Convergence: Different Starting Values",
    subtitle = "The final converged solution is unique and independent of the starting point.",
    x = "Iteration",
    y = "Coefficient Estimate Value",
    linetype = "Starting Value"
  ) +
  scale_color_manual(
    values = c("Beta0" = "gray50", "Beta1" = "red", "Beta2" = "blue")
  ) +
  theme_minimal(base_size = 14)
