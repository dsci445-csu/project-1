cat(sprintf("Initial estimate for beta1_hat: %.1f\n", beta1_hat))
cat(sprintf("Initial estimate for beta2_hat: %.1f\n", beta2_hat))
```
    
    
    c. Keeping $\hat{\beta}_1$ fixed, fit the model
    
        $$
        Y - \hat{\beta}_1 X_1 = \beta_0 + \beta_2 X_2 + \epsilon
        $$
        Set $\hat{\beta}_2 =$ the resulting coefficient from your fit.
```{r}
#adjusted response variable
Y_adj <- df_backfit$Y - (beta1_hat * df_backfit$X1)

#fit linear regression model
fit_beta2 <- lm(Y_adj ~ df_backfit$X2)

#update beta2_hat
beta2_hat <- coef(fit_beta2)[2]

cat(sprintf("Updated estimate for beta2_hat: %.4f\n", beta2_hat))

```
        
    
    d. Keeping $\hat{\beta}_2$ fixed, fit the model
    
        $$
        Y - \hat{\beta}_2 X_2 = \beta_0 + \beta_1 X_1 + \epsilon
        $$
        Set $\hat{\beta}_1 =$ the resulting coefficient from your fit.
        
```{r}


# 1. Create the new adjusted response variable (Partial Residuals)
# Y_adj_new = Y - beta2_hat * X2
Y_adj_new <- df_backfit$Y - (beta2_hat * df_backfit$X2)

# 2. Fit the simple linear regression model: Y_adj_new ~ X1
# This fits the model: Y - beta2_hat*X2 = beta0 + beta1*X1 + epsilon
fit_beta1 <- lm(Y_adj_new ~ df_backfit$X1)

# 3. Update beta1_hat: Extract the coefficient for X1 (the second coefficient)
# coef(fit_beta1)[1] is the new intercept (beta0)
# coef(fit_beta1)[2] is the new beta1_hat
beta1_hat <- coef(fit_beta1)[2]

# Print the updated estimate
cat(sprintf("Updated estimate for beta1_hat: %.4f\n", beta1_hat))

```
  
        
    e. Write a for loop to repeat c. and d. 1000 times. Make a line plot of the estimates of $\hat{\beta}_0, \hat{\beta_1}, \hat{\beta}_2$, at each iteration of the for loop with $\hat{\beta}_0, \hat{\beta_1}, \hat{\beta}_2$ each in a different color.
```{r}

true_beta0 <- 1

# True coefficients (for reference)
true_beta0 <- 1
true_beta1 <- 3
true_beta2 <- -4

# Initial estimates and storage setup
iterations <- 1000
beta0_hat <- 0 # Initialize intercept (often ignored, but necessary for lm)
beta1_hat <- 10 # Initialized as specified
beta2_hat <- 0  # Initialized to zero

# Matrix to store coefficient estimates at each step (3 coefficients + 1 for iteration)
coef_history <- matrix(NA, nrow = iterations, ncol = 4)
colnames(coef_history) <- c("Iteration", "Beta0", "Beta1", "Beta2")

#loop
for (k in 1:iterations) {
  

  # 1. Calculate Partial Residuals: Y_adj = Y - beta1_hat * X1
  Y_adj_for_beta2 <- df_backfit$Y - (beta1_hat * df_backfit$X1)
  
  # 2. Fit simple model: Y_adj_for_beta2 ~ X2
  fit_beta2 <- lm(Y_adj_for_beta2 ~ df_backfit$X2)
  
  # 3. Update coefficients
  beta0_hat <- coef(fit_beta2)[1] # Store new intercept
  beta2_hat <- coef(fit_beta2)[2] # Store new beta2_hat
  
  

  # 1. Calculate Partial Residuals: Y_adj = Y - beta2_hat * X2
  Y_adj_for_beta1 <- df_backfit$Y - (beta2_hat * df_backfit$X2)
  
  # 2. Fit simple model: Y_adj_for_beta1 ~ X1
  fit_beta1 <- lm(Y_adj_for_beta1 ~ df_backfit$X1)
  
  # 3. Update coefficients
  beta0_hat <- coef(fit_beta1)[1] # Store new intercept
  beta1_hat <- coef(fit_beta1)[2] # Store new beta1_hat
  
  
  # --- Store History ---
  coef_history[k, ] <- c(k, beta0_hat, beta1_hat, beta2_hat)
}

# --- Plotting Convergence ---

# 1. Convert the matrix to a data frame and pivot to long format
df_history <- as.data.frame(coef_history)
df_long <- df_history |>
  pivot_longer(
    cols = starts_with("Beta"),
    names_to = "Coefficient",
    values_to = "Estimate_Value"
  )

# 2. Create the line plot
ggplot(df_long, aes(x = Iteration, y = Estimate_Value, color = Coefficient, group = Coefficient)) +
  geom_line(linewidth = 1) +
  
  # Add horizontal lines for True Coefficients (for visual convergence check)
  geom_hline(yintercept = true_beta0, linetype = "dashed", color = "black") +
  geom_hline(yintercept = true_beta1, linetype = "dashed", color = "red") +
  geom_hline(yintercept = true_beta2, linetype = "dashed", color = "blue") +
  
  labs(
    title = "Backfitting Algorithm Convergence (1000 Iterations)",
    subtitle = "Initial beta1_hat = 10. Dashed lines show true coefficient values.",
    x = "Iteration",
    y = "Coefficient Estimate Value"
  ) +
  theme_minimal(base_size = 14) +
  # Customize colors to match true values
  scale_color_manual(
    values = c("Beta0" = "gray50", "Beta1" = "red", "Beta2" = "blue"),
    labels = c("Beta0" = "Intercept (True=1)", 
               "Beta1" = "Beta1 (True=3)", 
               "Beta2" = "Beta2 (True=-4)")
  )
```
    
    
