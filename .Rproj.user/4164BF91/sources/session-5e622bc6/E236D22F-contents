    n <- 1000
    
    X <- matrix(rnorm(n * p), nrow = n, ncol = p) ## predictors
    beta <- matrix(c(rnorm(8), rep(0, p - 8)), ncol = 1) ## 12 elements are equal to zero
    
    y <- X %*% beta + rnorm(n, 0, .5) ## y = Xbeta + epsilon
    ```

