1. We will explore the maximal margin classifier on a toy data set.

    a) We are given $n = 7$ observations in $p = 2$ dimensions. For each observation, there is an associated class label.
    
      ```{r, echo = FALSE, message = FALSE}
      library(knitr)
      library(dplyr)
    
      data.frame(Obs = 1:7, X_1 = c(3, 2, 4, 1, 2, 4, 4), X_2 = c(4, 2, 4, 4, 1, 3, 1), 
                 Y = c(rep("Red", 4), rep("Blue", 3))) %>%
      kable()
      ```
  
      Sketch the observations.
      
      
```{r}
n <- 500
x1 <- runif(n) - 0.5
x2 <- runif(n) - 0.5
y <- as.factor(as.numeric(x1^2 - x2^2 > 0)) # Create factor for classification

df_sim_nonlinear <- data.frame(X1 = x1, X2 = x2, Y = y)

# Plot the observations (Expected shape: Hyperbola)
library(ggplot2)
ggplot(df_sim_nonlinear, aes(x = X1, y = X2, color = Y)) +
  geom_point() +
  labs(title = "Simulated Data with Quadratic Decision Boundary") +
  theme_minimal()
```
      
    
    b) Sketch the optimal separating hyperplane and provide the equation for this hyperplane.
```{r}
library(tidymodels)

# Define Logistic Regression Spec
log_reg_spec <- logistic_reg() |> set_mode("classification") |> set_engine("glm")

# Fit the model
log_reg_linear_fit <- log_reg_spec |> 
  fit(Y ~ X1 + X2, data = df_sim_nonlinear)
```
    
  
    c) Describe the classification rule for the maximal marginal classifier. It should be along the lines of "Classify to Red if $\beta_0 + \beta_1 X_1 + \beta_2 X_2 > 0$, and classify as Blue otherwise. Provide the values of $\beta_0, \beta_1, \beta_2$.
    
```{r}
# Predict the class on the training data
df_pred_linear <- predict(log_reg_linear_fit, new_data = df_sim_nonlinear, type = "class")
df_sim_nonlinear_pred <- df_sim_nonlinear |> bind_cols(df_pred_linear)

# Plot predictions
ggplot(df_sim_nonlinear_pred, aes(x = X1, y = X2, color = .pred_class)) +
  geom_point() +
  labs(title = "Predicted Classes (Linear Logistic Regression)",
       subtitle = "Decision Boundary is a straight line") +
  theme_minimal()
```
    
  
    d) On your sketch, indicate the margin for the maximal margin classifier.
      
    e) Indicate the support vectors for the maximal margin classifier.
```{r}
# Fit the model with non-linear terms
library(ggplot2)

# Data frame setup (from previous steps)
df_mmc <- data.frame(
  X1 = c(3, 2, 4, 1, 2, 4, 4),
  X2 = c(4, 2, 4, 4, 1, 3, 1),
  Y = factor(c("Red", "Red", "Red", "Red", "Blue", "Blue", "Blue")),
  Is_SV = c("No", "Yes", "No", "No", "Yes", "No", "No") # Support Vector flag
)

# Define the location of the margin boundaries
margin_boundaries <- c(1.0, 2.0) # X2 = 1 and X2 = 2
hyperplane <- 1.5           # X2 = 1.5

ggplot(df_mmc, aes(x = X1, y = X2, color = Y)) +
  
  # Scatterplot of all observations
  geom_point(aes(size = Is_SV, shape = Is_SV)) +
  
  # 1. Draw the margin boundaries (the answer to d)
  geom_hline(yintercept = margin_boundaries, 
             linetype = "dotted", # Use dotted lines for boundaries
             color = "black", 
             linewidth = 1.0, 
             alpha = 0.7) +
  
  # 2. Draw the optimal separating hyperplane (Solid Line)
  geom_hline(yintercept = hyperplane, 
             linetype = "solid", 
             color = "black", 
             linewidth = 1.2) +
  
  # Highlight the Support Vectors (e)
  scale_size_manual(values = c(No = 3, Yes = 5), guide = "none") +
  scale_shape_manual(values = c(No = 16, Yes = 17), guide = "none") +
  
  labs(title = "Maximal Margin Classifier: Margin Indicated") +
  theme_bw() +
  coord_fixed(ratio = 1)
```
    

  
    f) Argue that a slight movement of the seventh observation would not affect the maximal margin hyperplane.
```{r}
# Define Radial SVM Spec (Non-Linear Kernel)
svm_rbf_spec <- svm_rbf() |> 
  set_mode("classification") |> 
  set_engine("kernlab")

# Fit the Radial SVM model
svm_rbf_fit <- svm_rbf_spec |> 
  fit(Y ~ X1 + X2, data = df_sim_nonlinear)

# Obtain Class Predictor for each training observation
df_pred_rbf <- predict(svm_rbf_fit, new_data = df_sim_nonlinear, type = "class")
df_sim_nonlinear_pred_rbf <- df_sim_nonlinear |> 
  select(X1, X2, Y) |> 
  bind_cols(df_pred_rbf)

# Plot the observations, colored according to the predicted class labels
ggplot(df_sim_nonlinear_pred_rbf, aes(x = X1, y = X2, color = .pred_class)) +
  geom_point(size = 2) +
  labs(title = "Predicted Classes (Non-Linear RBF SVM)",
       subtitle = "Boundary should accurately reflect the hyperbolic data separation") +
  theme_minimal()
```
    
  
